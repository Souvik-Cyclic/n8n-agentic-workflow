# Copy this file to .env and fill in the values, then: docker compose up -d
# This file holds NON-SECRET config only.
# The actual secrets (GitHub PAT, Gemini key) are added in the n8n UI as credentials — not here.

# ── Public URL ─────────────────────────────────────────────
# Where n8n is reachable from the internet (so GitHub can call the webhook and the
# approval-form resume links work). If you use the bundled cloudflared service, run
# `docker compose up -d`, read the printed https://<random>.trycloudflare.com URL from
# `docker compose logs cloudflared`, and paste it below.
N8N_HOST=your-subdomain.example.com
WEBHOOK_URL=https://your-subdomain.example.com/
GENERIC_TIMEZONE=Asia/Kolkata

# ── Vanguard config (the workflow reads these via $env) ────
GEMINI_URL=https://your-model-endpoint/v1/chat/completions   # OpenAI-compatible chat endpoint serving Gemini 2.5 Flash
EMAIL_SERVER_URL=https://your-email-service/send             # HTTP endpoint accepting { to, subject, body, cc }
REVIEWER_EMAIL=you@example.com                               # address that receives approval emails

# ── NOT stored here (add in n8n → Credentials → Header Auth) ──
# GitHub PAT : header "Authorization" = "Bearer <github-token>"  (PR write, contents read, actions read)
# Gemini key : header "Authorization" = "<key for your GEMINI_URL endpoint>"
