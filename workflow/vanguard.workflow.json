    {
      "parameters": {
        "jsCode": "\nlet txt=''; try{ txt=$json.choices[0].message.content; }catch(e){}\ntxt=String(txt).trim().replace(/^```(?:json)?/i,'').replace(/```$/i,'').trim();\nlet r={}; try{ r=JSON.parse(txt); }catch(e){ r={summary:'(could not parse review)',highlights:[],secrets:[],concerns:[]}; }\nconst ctx=$('Build Review Prompt').first().json;\nconst secrets=r.secrets||[]; const concerns=r.concerns||[]; const highlights=r.highlights||[];\nconst lines=[];\nlines.push('## \u2705 Automated Code Review');\nlines.push('');\nlines.push('_CI passed. Here\u2019s a quick review while you wait for sign-off._');\nlines.push('');\nlines.push('**Summary**  ');\nlines.push(r.summary||'');\nif(highlights.length){ lines.push(''); lines.push('**What changed**'); highlights.forEach(h=>lines.push('- '+h)); }\nif(concerns.length){ lines.push(''); lines.push('**Worth a look**'); concerns.forEach(c=>lines.push('- '+c)); }\nelse { lines.push(''); lines.push('No blocking concerns spotted. \u2705'); }\nif(secrets.length){ lines.push(''); lines.push('> \ud83d\udd10 **Possible hardcoded secret:** '+secrets.join(', ')); }\nlines.push('');\nlines.push('---');\nlines.push('<sub>Automated review \u00b7 a maintainer approves or requests changes by email.</sub>');\nconst comment=lines.join('\\n')+'\\n<!--auto-review-->';\nconst prUrl='https://github.com/'+ctx.repo+'/pull/'+ctx.pr;\nconst esc=s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nlet review_html='<p style=\"margin:0 0 10px\">'+esc(r.summary)+'</p>';\nif(highlights.length){ review_html+='<div style=\"font-weight:600;margin:8px 0 4px\">What changed</div><ul style=\"margin:0 0 6px;padding-left:18px\">'+highlights.map(h=>'<li>'+esc(h)+'</li>').join('')+'</ul>'; }\nif(concerns.length){ review_html+='<div style=\"font-weight:600;margin:8px 0 4px\">Worth a look</div><ul style=\"margin:0;padding-left:18px\">'+concerns.map(c=>'<li>'+esc(c)+'</li>').join('')+'</ul>'; }\nif(secrets.length){ review_html+='<p style=\"color:#b00020;margin:8px 0 0\">\ud83d\udd10 Possible hardcoded secret: '+esc(secrets.join(', '))+'</p>'; }\nreturn [{ json:{ repo:ctx.repo, pr:ctx.pr, sha:ctx.sha, review:r, comment, prUrl, review_html,\n  email_subject:'Action needed \u00b7 PR #'+ctx.pr+' passed CI in '+ctx.repo } }];\n"
      },
