    {
      "parameters": {
        "jsCode": "\nconst diff = ($json.data || '').slice(0, 12000);\nconst b = $('Webhook').first().json.body;\nconst wr = b.workflow_run;\nconst system = [\n  'You are a senior software engineer writing a concise, helpful pull-request review for the author.',\n  'Respond ONLY with strict JSON matching this shape, nothing else:',\n  '{\"summary\": string, \"highlights\": string[], \"concerns\": string[], \"secrets\": string[]}',\n  '- summary: 1-2 sentences on WHAT changed and the intent (not a line-by-line list).',\n  '- highlights: 2-4 short notable changes; skip trivia like blank lines or comments.',\n  '- concerns: things worth double-checking (tests, edge cases, naming, security). [] if none.',\n  '- secrets: hardcoded API keys/tokens/passwords/private keys in ADDED lines. [] if none.',\n  'No markdown, no code fences, no extra text.'\n].join('\\n');\nreturn [{ json: {\n  geminiBody: { model: 'google/gemini-2.5-flash', messages: [ {role:'system', content: system}, {role:'user', content: 'DIFF:\\n' + diff} ] },\n  repo: b.repository.full_name, pr: wr.pull_requests[0].number, sha: wr.head_sha\n} }];\n"
      },
